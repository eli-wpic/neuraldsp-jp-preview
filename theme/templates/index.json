        },
        "qc": {
          "type": "product",
          "settings": {
            "product": "quad-cortex",
            "model": "qc",
            "c0_eyebrow": "Neural DSP ／ Quad Cortex®",
            "c0_title": "Quad\nCortex",
            "c0_lead": "世界最高峰のフロア型アンプモデラー",
            "c0_body": "Quad Cortex® は、Neural DSP が開発した最先端のフロア型アンプモデラー & マルチエフェクターです。",
            "c1_label": "タッチスクリーン",
            "c1_title": "モデラーの新たな\n可能性を切り拓く",
            "c1_body": "<p>巨大な 7 インチタッチスクリーンを搭載した Quad Cortex は、驚くほど直感的に操作できます。どれほど複雑なシグナルパスも、手間なく構築可能です。</p>",
            "c2_label": "フットスイッチ",
            "c2_title": "11基のステンレス製\nストンプ＋ロータリー\nアクチュエーター",
            "c2_body": "<p>スイッチ操作と回転制御が可能。従来のフットスイッチ＆ノブのような操作感ながら、壊れにくい設計。</p>",
            "c3_label": "入力と出力",
            "c3_title": "入力と出力",
            "c3_body": "<ul class=\"chapter__list\"><li><b>デュアルコンボ入力</b>TS、TRS、XLR対応、可変インピーダンス＆レベルコントロール内蔵、マイクプリアンプ搭載、ファンタム電源対応。</li><li><b>デュアルエフェクトループ</b>外部のモノラル/ステレオエフェクトをシグナルチェーンに組み込むのに最適。</li><li><b>XLR 出力ジャック</b>2つのモノラル・バランスXLR出力ジャック。</li><li><b>USB</b>超低遅延オーディオ伝送、ファームウェア更新、MIDI通信などに対応。</li></ul>",
            "c4_label": "選ぶ",
            "c4_body": "7インチのタッチディスプレイと圧倒的な処理能力により、自由かつ直感的なトーン設計を実現します。",
            "c0_link_label": "プラグインの音を聴く",
            "c0_link_url": "#plugins"
          }
        },
        "mini": {
          "type": "product",
          "settings": {
            "product": "quad-cortex-mini",
            "model": "mini",
            "c0_eyebrow": "Neural DSP ／ Quad Cortex mini",
            "c0_title": "Quad Cortex\nmini",
            "c0_lead": "妥協ゼロ。ただ、コンパクト。",
            "c0_body": "Quad Cortex mini は、Neural DSP が誇るフラッグシップ Quad Cortex の体験を、コンパクトで使いやすいフォーマットに凝縮した次世代フロア型アンプモデラー＆マルチエフェクターです。",
            "c1_label": "The Grid",
            "c1_title": "リグ全体を\nひと目で把握。",
            "c1_body": "<p>The Grid は、Quad Cortex mini の中核となるビジュアル・ワークスペースです。複雑なセットアップでも読みやすく。シンプルなアイデアはそのままシンプルに。</p>",
            "c2_label": "フットスイッチ",
            "c2_title": "タッチスクリーン &\nロータリーフットスイッチ",
            "c2_body": "<p>7インチのマルチタッチ・ディスプレイと、4つのステンレス製ロータリーフットスイッチを組み合わせることで、指先でも足元でも、反応の良い直感的な操作が可能です。</p>",
            "c3_label": "入力と出力",
            "c3_title": "シンプルな接続。\n自由なセットアップ。",
            "c3_body": "<ul class=\"chapter__list\"><li><b>INPUT 2 / CAPTURE INPUT</b>専用のレベルコントロールとファンタム電源を備えた、コンボXLR／1/4インチ TRS入力。</li><li><b>DUAL EFFECTS LOOPS</b>SEND 1/2 および RETURN 1/2 は、それぞれ 1/4インチ TRS 端子を共有しています。</li><li><b>XLR OUTPUTS</b>2系統のモノラル・バランスXLR出力。</li><li><b>USB-C</b>マルチチャンネル（8イン／8アウト）USBオーディオインターフェースとして使用可能。</li></ul>",
            "c4_label": "選ぶ",
            "c4_body": "小さなボディ。大きなサウンド。"
          }
        },
        "nano": {
          "type": "product",
          "settings": {
            "product": "nano-cortex",
            "model": "nano",
            "c0_eyebrow": "Neural DSP ／ Nano Cortex®",
            "c0_title": "Nano\nCortex",
            "c0_lead": "あなたのトーン。あなたのリグ。どこでもプレイ",
            "c0_body": "Nano Cortex® は、Neural DSP が開発した手のひらサイズのデジタルアンプ & エフェクトプロセッサーです。",
            "c1_label": "コントロール",
            "c1_title": "手のひらに収まる、\n超強力なリグ",
            "c1_body": "<ul class=\"chapter__list\"><li><b>Bass, Mid, Treble</b>トーンを調整するためのコントロール。</li><li><b>Gain</b>Neural Captureに適用されるサチュレーションのレベルを調整します。</li><li><b>Capture</b>Neural Captureプロセスを開始します。</li></ul>",
            "c2_label": "フットスイッチ",
            "c2_title": "軽快に移動、\n圧倒的なサウンド",
            "c2_body": "<p>Nano Cortexは、2つのスタンダードなストンプボックスペダルを並べた幅と同じで、重さはわずか620g（1.36lbs）。ギグバッグやバックパックに簡単に収まります。</p>",
            "c3_label": "入力と出力",
            "c3_title": "入力と出力",
            "c3_body": "<ul class=\"chapter__list\"><li><b>1/4\" instrument input</b>ギターやベース用。</li><li><b>Dual 1/4\" TRS outputs</b>スタジオモニター、PAシステム、FRFRキャビネット用のステレオ出力。</li><li><b>USB-C</b>録音や電源供給に対応。</li><li><b>Capture input (XLR & TS)</b>Neural Captureを作成するための入力端子。</li></ul>",
            "c4_label": "選ぶ",
            "c4_body": "300種類の高品質IR、25種類のプリセットキャプチャーを搭載。"
          }
        }
      },
