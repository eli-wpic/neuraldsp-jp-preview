{%- comment -%}
  Feature cards: title and detail text shown on the card (no popups — review Nov 16) (neuraldsp.com/quad-cortex: Cab block & EQ, Switching Modes…).
{%- endcomment -%}
<section class="section nd-popcards{% if section.settings.band != blank %} nd-band nd-band--{{ section.settings.band }}{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}<header class="section-head"><h2>{{ section.settings.heading }}</h2></header>{%- endif -%}
    <div class="nd-popcards__grid" data-stagger>
      {%- for block in section.blocks -%}
        <article class="nd-popcards__card" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <div class="nd-prose">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ND · Feature cards",
  "settings": [
    {
      "type": "select",
      "id": "band",
      "label": "Band (as on neuraldsp.com)",
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Page colour"
        },
        {
          "value": "dark",
          "label": "Black band"
        },
        {
          "value": "light",
          "label": "White band"
        },
        {
          "value": "card",
          "label": "Rounded dark card"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Card link label",
      "default": "詳しく見る"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Detail (opens in a dialog)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ND · Feature cards"
    }
  ]
}
{% endschema %}
