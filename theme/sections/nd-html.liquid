{%- comment -%} Long-form content carried over from the old theme (legal pages, guides, comparison tables). {%- endcomment -%}
<section class="nd-html nd-html--{{ section.settings.width }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="nd-html__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.collapsed_label != blank -%}
      <details class="nd-more">
        <summary class="btn btn--nochev">{{ section.settings.collapsed_label }}</summary>
        <div class="nd-prose nd-prose--table">{{ section.settings.html }}</div>
      </details>
    {%- else -%}
      <div class="nd-prose nd-prose--table">{{ section.settings.html }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "ND · Text / HTML",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "html", "id": "html", "label": "Content (HTML)" },
    { "type": "text", "id": "collapsed_label", "label": "Hide behind a button (label)", "info": "When set, the content stays closed until this button is pressed." },
    { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [
      { "value": "narrow", "label": "Reading width" }, { "value": "wide", "label": "Wide" }
    ] }
  ],
  "presets": [{ "name": "ND · Text / HTML" }]
}
{% endschema %}
