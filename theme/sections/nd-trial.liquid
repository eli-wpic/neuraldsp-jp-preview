{%- comment -%}
  14-day trial dialog for plugin bundles. Opened by any element with [data-trial-open] (the product form shows one).
  The live store's version pointed the form at a placeholder URL (example.com); here the trial button sends people to the
  plugin's official download page, as agreed.
{%- endcomment -%}
{%- assign s = section.settings -%}
<dialog class="nd-dialog nd-trial" id="TrialDialog" aria-labelledby="TrialTitle">
  <button type="button" class="nd-dialog__close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  {%- if s.image != blank or s.image_url != blank -%}<div class="nd-trial__img">{% render 'nd-media', image: s.image, url: s.image_url, alt: '' %}</div>{%- endif -%}
  <h2 id="TrialTitle">{{ s.title | newline_to_br }}</h2>
  <p class="nd-trial__sub"><span>{{ s.subline }}</span></p>
  <p class="nd-trial__desc">{{ s.description }}</p>
  <form class="nd-trial__form" action="{{ s.trial_url }}" method="get" target="_blank" data-trial-form>
    <label class="visually-hidden" for="TrialEmail">{{ s.placeholder }}</label>
    <input id="TrialEmail" type="email" name="email" placeholder="{{ s.placeholder }}" autocomplete="email">
    <button class="btn btn--primary btn--ext" type="submit">{{ s.submit }}</button>
  </form>
  <div class="nd-trial__or"><span>OR</span></div>
  <div class="nd-trial__alt">
    <a class="btn btn--ext" href="{{ s.login_url }}" target="_blank" rel="noopener">{{ s.login_label }}</a>
    <a class="btn btn--ext" href="{{ s.register_url }}" target="_blank" rel="noopener">{{ s.register_label }}</a>
  </div>
</dialog>
{% schema %}
{
  "name": "ND · 14-day trial dialog",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Plugin image" },
    { "type": "text", "id": "image_url", "label": "Plugin image URL" },
    { "type": "textarea", "id": "title", "label": "Title" },
    { "type": "text", "id": "subline", "label": "Subline", "default": "14日間無料体験" },
    { "type": "text", "id": "description", "label": "Description", "default": "メールアドレスを入力して無料体験を始めましょう！" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "メールアドレスを入力する" },
    { "type": "text", "id": "submit", "label": "Trial button", "default": "無料体験する" },
    { "type": "text", "id": "trial_url", "label": "Trial / download URL", "default": "https://neuraldsp.com/downloads" },
    { "type": "text", "id": "login_label", "label": "Login label", "default": "ログイン" },
    { "type": "text", "id": "login_url", "label": "Login URL", "default": "https://neuraldsp.com/login" },
    { "type": "text", "id": "register_label", "label": "Register label", "default": "新規登録" },
    { "type": "text", "id": "register_url", "label": "Register URL", "default": "https://neuraldsp.com/register" }
  ],
  "presets": [{ "name": "ND · 14-day trial dialog" }]
}
{% endschema %}
