{%- comment -%}
  14-day trial dialog for plugin bundle pages: a download card with Windows / macOS installers, manual, changelog
  and past releases. Blank links show as 準備中 until the packages are added.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign plugin_name = s.plugin_name | default: s.title | split: 'を' | first | strip -%}
<dialog class="nd-dialog nd-trial" id="TrialDialog" aria-label="{{ plugin_name | escape }}">
  <button type="button" class="nd-dialog__close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  {% render 'nd-trial-panel', name: plugin_name, image: s.image, image_url: s.image_url, version: s.version, win: s.win_url, mac: s.mac_url, manual: s.manual_url, changelog: s.changelog_url, past: s.past_url %}
</dialog>
{% schema %}
{
  "name": "ND · 14-day trial dialog",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Plugin image" },
    { "type": "text", "id": "image_url", "label": "Plugin image URL" },
    { "type": "text", "id": "plugin_name", "label": "Plugin name (defaults to the title)" },
    { "type": "textarea", "id": "title", "label": "Title (legacy)" },
    { "type": "text", "id": "version", "label": "Version line (e.g. 1.0.0 - 2026年11月1日)" },
    { "type": "url", "id": "win_url", "label": "Windows installer URL" },
    { "type": "url", "id": "mac_url", "label": "macOS installer URL" },
    { "type": "url", "id": "manual_url", "label": "Manual URL" },
    { "type": "url", "id": "changelog_url", "label": "Changelog URL" },
    { "type": "url", "id": "past_url", "label": "Past releases URL" },
    { "type": "text", "id": "subline", "label": "Subline", "default": "14日間無料体験" },
    { "type": "text", "id": "description", "label": "Description", "default": "メールアドレスを入力して無料体験を始めましょう！" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "メールアドレスを入力する" },
    { "type": "text", "id": "submit", "label": "Trial button", "default": "無料体験する" },
    { "type": "text", "id": "trial_url", "label": "Trial / download URL", "default": "https://neuraldsp.com/downloads" },
    { "type": "text", "id": "login_label", "label": "Login label", "default": "ログイン" },
    { "type": "text", "id": "login_url", "label": "Login URL", "default": "https://neuraldsp.com/login" },
    { "type": "text", "id": "register_label", "label": "Register label", "default": "新規登録" },
    { "type": "text", "id": "register_url", "label": "Register URL", "default": "https://neuraldsp.com/register" }
  ],
  "presets": [{ "name": "ND · 14-day trial dialog" }]
}
{% endschema %}
