<section class="nd-page-head nd-account"><div class="container">
  <p class="crumbs"><a href="{{ routes.account_url }}">{{ 'customer.account' | t }}</a></p>
  <h1>{{ order.name }}</h1>
  <p>{{ order.created_at | date: '%Y.%m.%d %H:%M' }} ・ {{ order.financial_status_label }} ・ {{ order.fulfillment_status_label }}</p>
  <table class="nd-table"><thead><tr><th>{{ 'customer.product' | t }}</th><th>{{ 'cart.quantity' | t }}</th><th>{{ 'cart.subtotal' | t }}</th></tr></thead><tbody>
    {%- for item in order.line_items -%}<tr><td>{{ item.title }}</td><td>{{ item.quantity }}</td><td>{{ item.final_line_price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
  </tbody><tfoot><tr><th colspan="2">{{ 'customer.total' | t }}</th><td>{{ order.total_price | money_without_trailing_zeros }}</td></tr></tfoot></table>
  {%- if order.shipping_address -%}<h2>{{ 'customer.shipping' | t }}</h2><p>{{ order.shipping_address | format_address }}</p>{%- endif -%}
</div></section>
{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
