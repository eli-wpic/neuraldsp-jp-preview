{%- assign blog = blogs[section.settings.blog] -%}
<section class="nd-posts">
  <div class="container">
    <div class="nd-posts__head">
      <h2>{{ section.settings.heading }}</h2>
      <a class="link-arrow" href="{{ blog.url }}">{{ section.settings.view_all }} {% render 'icon', name: 'arrow' %}</a>
    </div>
    <div class="nd-posts__grid">
      {%- for article in blog.articles limit: section.settings.count -%}
        <a class="nd-post" href="{{ article.url }}">
          <span class="nd-post__media">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(max-width: 760px) 100vw, 33vw', alt: article.title }}{%- endif -%}</span>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%Y.%m.%d' }}</time>
          <strong>{{ article.title }}</strong>
          <span class="nd-post__more">{{ section.settings.read_more }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ND · Blog posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "default": "news" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest News" },
    { "type": "text", "id": "view_all", "label": "View all label", "default": "すべての投稿を見る" },
    { "type": "text", "id": "read_more", "label": "Read more label", "default": "続きを読む" },
    { "type": "range", "id": "count", "label": "Posts", "min": 3, "max": 9, "step": 3, "default": 3 }
  ],
  "presets": [{ "name": "ND · Blog posts" }]
}
{% endschema %}
