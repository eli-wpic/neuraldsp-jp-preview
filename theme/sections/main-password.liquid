<section class="nd-page-head nd-password"><div class="container">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'nd-form' -%}
    {%- if form.errors -%}<div class="nd-form__err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label>{{ 'general.password' | t }}<input type="password" name="password" autocomplete="current-password"></label>
    <button class="btn btn--primary" type="submit">{{ 'general.enter' | t }}</button>
  {%- endform -%}
</div></section>
{% schema %}
{ "name": "Password", "tag": "section", "settings": [] }
{% endschema %}
