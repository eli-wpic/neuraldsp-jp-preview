{%- comment -%}
  Campaign banner with motion (see snippets/nd-banner.liquid). Upload the finished banner as one image; effects play on top of it.
  "Show during the site campaign" ties it to Theme settings → Colours → campaign (same switch and dates).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign show = true -%}
{%- if s.follow_site -%}
  {%- assign today = 'now' | date: '%Y-%m-%d' -%}
  {%- assign show = false -%}
  {%- if settings.campaign_on -%}
    {%- assign show = true -%}
    {%- if settings.campaign_start != blank and today < settings.campaign_start -%}{%- assign show = false -%}{%- endif -%}
    {%- if settings.campaign_end != blank and today > settings.campaign_end -%}{%- assign show = false -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if show -%}
<section class="nd-campaign{% if s.full_width %} nd-campaign--full{% endif %}">
  <div class="container">
    {%- if s.url != blank -%}<a class="nd-campaign__link" href="{{ s.url }}" aria-label="{{ s.alt | escape }}">{%- else -%}<div class="nd-campaign__link">{%- endif -%}
      {% render 'nd-banner', s: s %}
    {%- if s.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- if s.button_label != blank and s.url != blank -%}<a class="btn btn--primary nd-campaign__btn" href="{{ s.url }}">{{ s.button_label }}</a>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "ND · Campaign banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "follow_site",
      "label": "Show during the site campaign only",
      "default": true,
      "info": "Appears and disappears with Theme settings → Colours → campaign."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Banner image URL"
    },
    {
      "type": "text",
      "id": "mobile_image_url",
      "label": "Phone banner URL (optional)",
      "info": "A taller 4:5 version reads better on phones; without it the wide banner is used."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Theme asset file (fallback)",
      "info": "Used only when no banner image is set."
    },
    {
      "type": "header",
      "content": "Effects on top of the banner (the banner itself is never changed)"
    },
    {
      "type": "checkbox",
      "id": "fx_sheen",
      "label": "Light sweep",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fx_glow",
      "label": "Glow pulse (campaign colour)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fx_sparks",
      "label": "Drifting sparks (campaign colour)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fx_grain",
      "label": "Film grain",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fx_push",
      "label": "Gentle push-in of the whole banner",
      "default": false
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "text",
      "id": "url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    }
  ],
  "presets": [
    {
      "name": "ND · Campaign banner"
    }
  ]
}
{% endschema %}
