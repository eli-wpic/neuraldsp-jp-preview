<section class="nd-faq-section"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="container">
    <header class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </header>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="nd-prose">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ND · FAQ",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id (for links like #faq)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "よくあるご質問" }
  ],
  "blocks": [{ "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question" },
    { "type": "html", "id": "answer", "label": "Answer (HTML)" }
  ] }],
  "presets": [{ "name": "ND · FAQ" }]
}
{% endschema %}
