{%- comment -%} Numbered list beside an image — used for inputs/outputs and controls. {%- endcomment -%}
<section class="nd-numbered">
  <div class="container">
    <header class="section-head">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </header>
    <div class="nd-numbered__grid{% if section.settings.image == blank and section.settings.image_url == blank %} nd-numbered__grid--full{% endif %}">
      {%- if section.settings.image != blank or section.settings.image_url != blank -%}
        <div class="nd-numbered__media">{% render 'nd-media', image: section.settings.image, url: section.settings.image_url, alt: section.settings.heading, sizes: '(max-width: 900px) 100vw, 50vw' %}</div>
      {%- endif -%}
      <ol class="nd-numbered__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="nd-numbered__n">{{ block.settings.number | default: forloop.index }}</span>
            <div>{%- if block.settings.title != blank -%}<b>{{ block.settings.title }}</b>{%- endif -%}{%- if block.settings.text != blank -%}<div class="nd-prose">{{ block.settings.text }}</div>{%- endif -%}</div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ND · Numbered list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL" }
  ],
  "blocks": [{ "type": "item", "name": "Item", "settings": [
    { "type": "text", "id": "number", "label": "Number" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "html", "id": "text", "label": "Text (HTML)" }
  ] }],
  "presets": [{ "name": "ND · Numbered list" }]
}
{% endschema %}
