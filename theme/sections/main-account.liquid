<section class="nd-page-head nd-account"><div class="container">
  <h1>{{ 'customer.account' | t }}</h1>
  <p>{{ customer.name }} ・ <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a> ・ <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a></p>
  <h2>{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="nd-table"><thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'cart.subtotal' | t }}</th></tr></thead><tbody>
        {%- for order in customer.orders -%}<tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%Y.%m.%d' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money_without_trailing_zeros }}</td></tr>{%- endfor -%}
      </tbody></table>
    {%- else -%}<p>{{ 'customer.no_orders' | t }}</p>{%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div></section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
