{%- assign s = section.settings -%}
<section class="section" id="compare" data-compare aria-labelledby="CompareTitle-{{ section.id }}">
  <div class="container">
    <header class="section-head reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 id="CompareTitle-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.body != blank -%}<p>{{ s.body }}</p>{%- endif -%}
    </header>
    {%- if s.show_chooser -%}
    <form class="chooser reveal" data-chooser onsubmit="return false">
      <fieldset><legend>{{ s.q1 }}</legend>
        <span class="seg">
          <label><input type="radio" name="plugins" value="yes"><span>{{ s.q1_yes }}</span></label>
          <label><input type="radio" name="plugins" value="no"><span>{{ s.q1_no }}</span></label>
        </span>
      </fieldset>
      <fieldset><legend>{{ s.q2 }}</legend>
        <span class="seg">
          <label><input type="radio" name="priority" value="features"><span>{{ s.q2_features }}</span></label>
          <label><input type="radio" name="priority" value="portable"><span>{{ s.q2_portable }}</span></label>
          <label><input type="radio" name="priority" value="price"><span>{{ s.q2_price }}</span></label>
        </span>
      </fieldset>
      <b aria-live="polite" data-chooser-out data-prefix="{{ s.rec_prefix | escape }}"></b>
    </form>
    {%- endif -%}
    {%- comment -%} Visual comparison: the products drawn to real scale, then a few rows shown as icons, dots and bars. {%- endcomment -%}
    {%- assign max_w = 0 -%}{%- assign max_kg = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign w = block.settings.width_cm | plus: 0 -%}{%- if w > max_w -%}{%- assign max_w = w -%}{%- endif -%}
      {%- assign kg = block.settings.weight_g | plus: 0 -%}{%- if kg > max_kg -%}{%- assign max_kg = kg -%}{%- endif -%}
    {%- endfor -%}
    <div class="vs" style="--n: {{ section.blocks.size }}">
      <div class="vs__row vs__row--units">
        <span class="vs__label"></span>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}{%- assign p = b.product -%}
          {%- assign scale = 100 -%}
          {%- if max_w > 0 and b.width_cm != blank -%}{%- assign scale = b.width_cm | times: 100.0 | divided_by: max_w | round -%}{%- endif -%}
          <article class="vs__unit compare__col" data-rec="{{ b.recommend_for }}" data-name="{{ p.title | escape }}" {{ block.shopify_attributes }}>
            <span class="compare__badge">{{ s.badge }}</span>
            <div class="vs__img"><div style="width: {{ scale }}%">{% render 'nd-product-thumb', product: p, width: 600 %}</div></div>
            <h3>{{ p.title }}</h3>
            <p class="vs__role">{{ b.role }}</p>
            <p class="vs__price">{% render 'nd-price', price: p.price %}<small>{{ s.tax_label }}</small></p>
          </article>
        {%- endfor -%}
      </div>

      <div class="vs__row">
        <span class="vs__label">{{ s.size_label }}</span>
        {%- for block in section.blocks -%}<span class="vs__val">{{ block.settings.size_text }}</span>{%- endfor -%}
      </div>
      <div class="vs__row">
        <span class="vs__label">{{ s.weight_label }}</span>
        {%- for block in section.blocks -%}
          {%- assign g = block.settings.weight_g | plus: 0 -%}
          {%- assign pct = 0 -%}{%- if max_kg > 0 -%}{%- assign pct = g | times: 100.0 | divided_by: max_kg | round -%}{%- endif -%}
          <span class="vs__val"><i class="vs__bar"><b style="width: {{ pct }}%"></b></i>{%- if g >= 1000 -%}{{ g | divided_by: 1000.0 | round: 2 }}kg{%- else -%}{{ g }}g{%- endif -%}</span>
        {%- endfor -%}
      </div>
      <div class="vs__row">
        <span class="vs__label">{{ s.switch_label }}</span>
        {%- for block in section.blocks -%}
          {%- assign n = block.settings.switches | plus: 0 -%}
          <span class="vs__val"><i class="vs__dots" aria-hidden="true">{%- for i in (1..n) -%}<b></b>{%- endfor -%}</i>{{ n }}</span>
        {%- endfor -%}
      </div>
      {%- for r in (1..3) -%}
        {%- case r -%}
          {%- when 1 -%}{%- assign key = 'screen' -%}{%- assign label = s.screen_label -%}
          {%- when 2 -%}{%- assign key = 'capture' -%}{%- assign label = s.capture_label -%}
          {%- else -%}{%- assign key = 'plugins' -%}{%- assign label = s.plugins_label -%}
        {%- endcase -%}
        <div class="vs__row">
          <span class="vs__label">{{ label }}</span>
          {%- for block in section.blocks -%}
            {%- if block.settings[key] -%}<span class="vs__val vs__yes" aria-label="{{ s.yes_label }}"><i></i></span>
            {%- else -%}<span class="vs__val vs__no" aria-label="{{ s.no_label }}"><i></i></span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
      <div class="vs__row vs__row--cta">
        <span class="vs__label"></span>
        {%- for block in section.blocks -%}<span class="vs__val"><a class="btn btn--small{% if forloop.first %} btn--primary{% endif %}" href="{{ block.settings.product.url }}">{{ s.button }}</a></span>{%- endfor -%}
      </div>
    </div>
  </div>
</section>
<script type="module" src="{{ 'compare.js' | asset_url }}"></script>
{% schema %}
{
  "name": "ND · Compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "body", "label": "Text" },
    { "type": "checkbox", "id": "show_chooser", "label": "Show the two-question chooser", "default": true },
    { "type": "text", "id": "q1", "label": "Question 1" },
    { "type": "text", "id": "q1_yes", "label": "Q1 yes" },
    { "type": "text", "id": "q1_no", "label": "Q1 no" },
    { "type": "text", "id": "q2", "label": "Question 2" },
    { "type": "text", "id": "q2_features", "label": "Q2 features" },
    { "type": "text", "id": "q2_portable", "label": "Q2 portable" },
    { "type": "text", "id": "q2_price", "label": "Q2 price" },
    { "type": "text", "id": "rec_prefix", "label": "Recommendation prefix", "default": "おすすめ：" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "おすすめ" },
    { "type": "text", "id": "tax_label", "label": "Tax label", "default": "税込" },
    { "type": "text", "id": "button", "label": "Button", "default": "詳しく見る" },
    { "type": "text", "id": "size_label", "label": "Size row", "default": "サイズ" },
    { "type": "text", "id": "weight_label", "label": "Weight row", "default": "重さ" },
    { "type": "text", "id": "switch_label", "label": "Footswitch row", "default": "フットスイッチ" },
    { "type": "text", "id": "screen_label", "label": "Touchscreen row", "default": "タッチスクリーン" },
    { "type": "text", "id": "capture_label", "label": "Neural Capture row", "default": "Neural Capture" },
    { "type": "text", "id": "plugins_label", "label": "Plugins row", "default": "プラグイン対応" },
    { "type": "text", "id": "yes_label", "label": "Yes (screen readers)", "default": "対応" },
    { "type": "text", "id": "no_label", "label": "No (screen readers)", "default": "非対応" },
    { "type": "text", "id": "row1_label", "label": "Row 1 label" },
    { "type": "text", "id": "row2_label", "label": "Row 2 label" },
    { "type": "text", "id": "row3_label", "label": "Row 3 label" },
    { "type": "text", "id": "row4_label", "label": "Row 4 label" },
    { "type": "text", "id": "row5_label", "label": "Row 5 label" }
  ],
  "blocks": [{ "type": "model", "name": "Model", "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "role", "label": "Role" },
    { "type": "text", "id": "recommend_for", "label": "Recommend for", "info": "Comma list of: features_yes, features_no, portable_yes, portable_no, price_yes, price_no" },
    { "type": "number", "id": "width_cm", "label": "Width (cm) — draws the product to scale" },
    { "type": "text", "id": "size_text", "label": "Size text" },
    { "type": "number", "id": "weight_g", "label": "Weight (g)" },
    { "type": "number", "id": "switches", "label": "Footswitches" },
    { "type": "checkbox", "id": "screen", "label": "Touchscreen", "default": true },
    { "type": "checkbox", "id": "capture", "label": "Neural Capture", "default": true },
    { "type": "checkbox", "id": "plugins", "label": "Plugin support", "default": true },
    { "type": "text", "id": "v1", "label": "Row 1" },
    { "type": "text", "id": "v2", "label": "Row 2" },
    { "type": "text", "id": "v3", "label": "Row 3" },
    { "type": "text", "id": "v4", "label": "Row 4" },
    { "type": "text", "id": "v5", "label": "Row 5" }
  ] }],
  "presets": [{ "name": "ND · Compare" }]
}
{% endschema %}
