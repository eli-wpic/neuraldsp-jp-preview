{%- comment -%}
  Campaign banner = ONE uploaded image, shown exactly as designed (never cropped, nothing inside it is moved).
  Optional effect layers sit on top of it: light sweep, accent glow, drifting sparks, film grain, gentle push-in of the whole image.
  Params: s (settings): image / image_url / image_asset, mobile_image_url, alt, fx_sheen, fx_glow, fx_sparks, fx_grain, fx_push.
  Effects use the campaign colour (Theme settings → Colours) and stop for visitors who ask for reduced motion.
{%- endcomment -%}
<div class="nd-banner" data-banner{% if s.fx_sheen != false %} data-fx-sheen{% endif %}{% if s.fx_glow != false %} data-fx-glow{% endif %}{% if s.fx_sparks != false %} data-fx-sparks{% endif %}{% if s.fx_grain %} data-fx-grain{% endif %}{% if s.fx_push %} data-fx-push{% endif %}>
  <picture class="nd-banner__img">
    {%- if s.mobile_image_url != blank -%}<source media="(max-width: 749px)" srcset="{{ s.mobile_image_url | split: '?' | first }}?width=1000">{%- endif -%}
    {%- if s.image != blank or s.image_url != blank -%}
      {% render 'nd-media', image: s.image, url: s.image_url, alt: s.alt, loading: 'eager', sizes: '(max-width: 1280px) 100vw, 1400px' %}
    {%- elsif s.image_asset != blank -%}
      <img src="{{ s.image_asset | asset_url }}" alt="{{ s.alt | escape }}" width="1920" height="1080" loading="eager">
    {%- endif -%}
  </picture>
  <i class="nd-banner__fx nd-banner__glow" aria-hidden="true"></i>
  <i class="nd-banner__fx nd-banner__sparks" aria-hidden="true">{%- for n in (1..18) -%}<b style="--x: {{ n | times: 53 | modulo: 100 }}%; --t: {{ n | times: 7 | modulo: 11 | plus: 7 }}s; --dl: {{ n | times: 13 | modulo: 9 }}s; --sz: {{ n | modulo: 3 | plus: 2 }}px"></b>{%- endfor -%}</i>
  <i class="nd-banner__fx nd-banner__grain" aria-hidden="true"></i>
  <i class="nd-banner__fx nd-banner__sheen" aria-hidden="true"></i>
</div>
