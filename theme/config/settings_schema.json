[
  {
    "name": "theme_info",
    "theme_name": "Neural DSP Japan",
    "theme_version": "1.0.0",
    "theme_author": "WPIC Creative",
    "theme_documentation_url": "https://neuraldsp.jp",
    "theme_support_url": "https://neuraldsp.jp/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colours",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Site colour",
        "default": "dark",
        "options": [
          {
            "value": "dark",
            "label": "Dark"
          },
          {
            "value": "light",
            "label": "White"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "color_bar",
        "label": "Show the colour bar at the top",
        "default": true,
        "info": "Lets visitors switch between dark and white. Turn off to lock the site to the colour above."
      },
      {
        "type": "header",
        "content": "Seasonal campaign"
      },
      {
        "type": "paragraph",
        "content": "To run a campaign: tick the box, set the dates, and pick two colours: Background and Buttons. Text, cards and the top strip adjust by themselves. Upload the campaign graphic in the home page banner."
      },
      {
        "type": "checkbox",
        "id": "campaign_on",
        "label": "Use the campaign colours",
        "default": false
      },
      {
        "type": "text",
        "id": "campaign_label",
        "label": "Campaign name (colour bar)",
        "default": "BLACK FRIDAY"
      },
      {
        "type": "text",
        "id": "campaign_start",
        "label": "Start date (YYYY-MM-DD)"
      },
      {
        "type": "text",
        "id": "campaign_end",
        "label": "End date (YYYY-MM-DD)"
      },
      {
        "type": "color",
        "id": "campaign_bg",
        "label": "Background",
        "default": "#050505"
      },
      {
        "type": "color",
        "id": "campaign_accent",
        "label": "Buttons and highlights",
        "default": "#cb2b1e"
      },
      {
        "type": "text",
        "id": "campaign_strip_text",
        "label": "Strip text",
        "info": "e.g. 11/28（金）〜12/1（月）。The campaign name shows in the accent colour before it."
      },
      {
        "type": "header",
        "content": "Fine-tuning (optional — leave empty for automatic)"
      },
      {
        "type": "color",
        "id": "campaign_text",
        "label": "Text colour (automatic: white on dark, black on light)"
      },
      {
        "type": "color",
        "id": "campaign_accent_text",
        "label": "Text on buttons (automatic)"
      },
      {
        "type": "color",
        "id": "campaign_surface",
        "label": "Cards and panels (automatic)"
      },
      {
        "type": "color",
        "id": "campaign_strip_bg",
        "label": "Top strip background (automatic)"
      },
      {
        "type": "image_picker",
        "id": "campaign_bg_image",
        "label": "Background image (optional)"
      },
      {
        "type": "text",
        "id": "campaign_bg_image_url",
        "label": "Background image URL (optional)"
      },
      {
        "type": "checkbox",
        "id": "campaign_strip",
        "label": "Show the campaign strip",
        "default": true
      },
      {
        "type": "url",
        "id": "campaign_strip_link",
        "label": "Strip link"
      },
      {
        "type": "checkbox",
        "id": "campaign_countdown",
        "label": "Countdown to the end date",
        "default": true
      },
      {
        "type": "text",
        "id": "campaign_countdown_label",
        "label": "Countdown label",
        "default": "終了まで"
      },
      {
        "type": "range",
        "id": "campaign_glow",
        "label": "Accent glow behind products (%)",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 14
      },
      {
        "type": "checkbox",
        "id": "campaign_grain",
        "label": "Film grain texture",
        "default": true
      }
    ]
  },
  {
    "name": "Videos",
    "settings": [
      {
        "type": "paragraph",
        "content": "Self-hosted copies of the YouTube videos (no ads, no YouTube player). Upload each mp4 in Content → Files, copy its link, and paste it after the matching YouTube ID. One per line: YouTubeID|https://cdn.shopify.com/videos/…mp4. A video without a link keeps using YouTube."
      },
      {
        "type": "textarea",
        "id": "video_files",
        "label": "Video files",
        "default": ""
      }
    ]
  }
]